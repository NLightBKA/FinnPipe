services:
  postgres:
    image: postgres:16
    container_name: quantflow-postgres
    ports:
      - "5432:5432"
    environment:
      POSTGRES_DB: quantflow
      POSTGRES_USER: admin
      POSTGRES_PASSWORD: yourpassword
    volumes:
      - postgres_data:/var/lib/postgresql/data

  clickhouse:
    image: clickhouse/clickhouse-server:latest
    container_name: quantflow-clickhouse
    ports:
      - "8123:8123"
      - "9000:9000"
    environment:
      CLICKHOUSE_DB: quantflow
      CLICKHOUSE_USER: default
      CLICKHOUSE_PASSWORD: yourpassword
    volumes:
      - clickhouse_data:/var/lib/clickhouse

volumes:
  postgres_data:
  clickhouse_data:services:
  postgres:
    image: postgres:16
    container_name: quantflow-postgres
    ports:
      - "5432:5432"
    environment:
      POSTGRES_DB: quantflow
      POSTGRES_USER: admin
      POSTGRES_PASSWORD: yourpassword
    volume
